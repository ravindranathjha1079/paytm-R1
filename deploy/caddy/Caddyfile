# seatres edge. Runs with host networking on 9080/9443; seatres-net redirects the seatres public IP's
# 80/443 here. senti's Caddy (on the primary IP) is never touched.
{
	http_port 9080
	https_port 9443
	admin localhost:2099
	# Externally this is still :80/:443, so build redirects ourselves rather than to :9443.
	auto_https disable_redirects
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

http://{$SEATRES_FQDN} {
	redir https://{host}{uri} permanent
}

{$SEATRES_FQDN} {
	encode zstd gzip

	# Live logs (read-only Dozzle, this stack's containers only).
	handle /logs* {
		basic_auth {
			{$LOGS_USER} {$LOGS_HASH}
		}
		reverse_proxy 127.0.0.1:8081
	}

	# Dashboards (anonymous read-only Grafana).
	handle /grafana* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		reverse_proxy {$API_UPSTREAM:127.0.0.1:8080} {
			# While the API restarts or redeploys, keep retrying the *dial* (the request was never sent, so
			# this is always safe) instead of answering 502.
			lb_try_duration 15s
			lb_try_interval 250ms
			# A POST can only be re-dialled if its body can be replayed; reserve/confirm bodies are tiny.
			request_buffers 64KiB
			# Requests already sent when a restarting API closed the connection may also be retried, but only on
			# routes that are idempotent by design (reserve/confirm carry idempotency keys; cancel is idempotent).
			lb_retry_match {
				path /shows/*/reserve /reservations/*
			}
			lb_retry_match {
				method GET
			}
			transport http {
				# Bounded upstream: excess requests queue here instead of opening thousands of connections.
				max_conns_per_host 768
				dial_timeout 10s
				keepalive 2m
				keepalive_idle_conns 768
			}
		}
	}
}
